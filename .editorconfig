# 多语言仓库（Rust/PS1/Py/YAML/TOML/MD）统一编辑器基线（dev-config-audit C6）
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
# 换行符不钉死：仓库仅 .githooks 显式 LF（.gitattributes），其余交给 git autocrlf

[*.ps1]
charset = utf-8-bom   # G-23：入库 .ps1 一律带 UTF-8 BOM

[*.{rs,py,toml}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # 行尾双空格 = 硬换行语义，勿剪
